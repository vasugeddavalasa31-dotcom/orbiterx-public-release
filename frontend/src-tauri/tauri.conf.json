{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbiterX",
  "version": "1.2.44",
  "identifier": "ai.orbiterx.desktop",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../out": "web/"
    },
    "externalBin": ["binaries/codeg-mcp", "binaries/orbiterx-app-server"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1ODVEQUM5RUQ2MUU1OTIKUldTUzVXSHR5ZHFGSlRaVm5UL0hFbmpUK1dSOUlzbUp4Uk4vRm4rSVZKNzhJUEloTVdvWjc4ZDMK",
      "endpoints": [
        "https://github.com/vasugeddavalasa31-dotcom/orbiterx-public-release/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
